# User-installed commands must be available before initializing mise and other tools.
export PATH="$HOME/.local/bin:$PATH"

# mise
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if [[ -t 0 ]]; then
  export GPG_TTY=$(tty)
fi

# git branch show
autoload -Uz vcs_info add-zsh-hook
autoload -U colors && colors

setopt prompt_subst
zstyle ':vcs_info:*' enable git svn
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr ' *'
zstyle ':vcs_info:*' stagedstr ' +'
zstyle ':vcs_info:git*' formats "%{$fg[blue]%}%b%u%c%{$reset_color%}"
zstyle ':vcs_info:git*' actionformats "%{$fg[blue]%}%b|%a%u%c%{$reset_color%}"

# https://vincent.bernat.ch/en/blog/2019-zsh-async-vcs-info
_vbe_vcs_info() {
  cd -q $1
  vcs_info
  print ${vcs_info_msg_0_}
}

if [[ -r "$HOME/.config/async.zsh" ]]; then
  source "$HOME/.config/async.zsh"
  async_init
  async_start_worker vcs_info
  async_register_callback vcs_info _vbe_vcs_info_done
fi

_vbe_vcs_info_done() {
  local stdout=$3
  vcs_info_msg_0_=$stdout
  zle reset-prompt
}

_vbe_vcs_precmd() {
  (( $+functions[async_job] )) || return
  async_flush_jobs vcs_info
  async_job vcs_info _vbe_vcs_info $PWD
}

add-zsh-hook precmd _vbe_vcs_precmd

# add-zsh-hook precmd vcs_info
PROMPT=$'
%(?..%F{red}%?%f )%~ ${vcs_info_msg_0_}
%F{magenta}\U27E9%f '

# editor setting
export EDITOR="nvim"

# zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# fzf
if command -v fzf >/dev/null 2>&1 && fzf --help 2>&1 | grep -q -- '--zsh'; then
  source <(fzf --zsh)
fi


# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# deno
export DENO_INSTALL="$HOME/.deno"
export PATH="$DENO_INSTALL/bin:$PATH"

if [[ "$(uname -s)" == Darwin ]]; then
  # llvm
  if command -v brew >/dev/null 2>&1 && brew --prefix llvm >/dev/null 2>&1; then
    llvm_prefix="$(brew --prefix llvm)"
    export PATH="$llvm_prefix/bin:$PATH"
    export LDFLAGS="-L$llvm_prefix/lib"
    export CPPFLAGS="-I$llvm_prefix/include"
  fi

  # mysql
  [[ -d /usr/local/mysql/bin ]] && export PATH="/usr/local/mysql/bin:$PATH"
fi

# zsh-autosuggestions
if command -v brew >/dev/null 2>&1; then
  zsh_share="$(brew --prefix)/share"
else
  zsh_share="/usr/share"
fi
[[ -r "$zsh_share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] &&
  source "$zsh_share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# zsh-syntax-highlighting
[[ -r "$zsh_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] &&
  source "$zsh_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
unset zsh_share

# Private env
[ -f ~/.env ] && source ~/.env

# Work-specific zshrc
[ -f ~/.zshrc-work ] && source ~/.zshrc-work

if command -v brew >/dev/null 2>&1; then
  brew-backup() {
    command brew bundle dump --force --file="$HOME/.config/brew/Brewfile"
  }

  brew() {
    command brew "$@"
    local brew_status=$?

    case "$1" in
      install|remove|uninstall)
        (( brew_status == 0 )) && brew-backup
        ;;
    esac

    return $brew_status
  }
fi

# ALIAS
if command -v eza >/dev/null 2>&1; then
  alias "ls"="eza"
  alias "l"="eza -l --classify=auto --group-directories-first"
fi
alias "colortest"="~/.config/colortest"

alias gadd="
git ls-files -m -o --exclude-standard |
  fzf -m --preview 'git diff --color=always {} 2>/dev/null || cat {}' |
  xargs git add
"

alias gunstage="
git diff --cached --name-only |
  fzf -m --preview 'git diff --cached --color=always {} 2>/dev/null || cat {}' |
  xargs git restore --staged
"

# FUNCS
proj() {
  command -v zoxide >/dev/null 2>&1 || return 1
  command -v fzf >/dev/null 2>&1 || return 1
  local dir
  local preview='ls -la {}'
  command -v eza >/dev/null 2>&1 && preview='eza -l --color=always {}'
  dir=$(zoxide query -l | fzf --preview "$preview") || return
  pushd "$dir" > /dev/null
  nvim .
  popd > /dev/null
}

[[ -r "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

alias codx="codex --yolo"
alias clawd="claude --dangerously-skip-permissions --worktree"

# pnpm
if [[ "$(uname -s)" == Darwin ]]; then
  export PNPM_HOME="$HOME/Library/pnpm"
else
  export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
fi
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
